diff --git a/tests/unit/docker-test-labels.test.ts b/tests/unit/docker-test-labels.test.ts
new file mode 100644
index 0000000..e4f5ee5
--- /dev/null
+++ b/tests/unit/docker-test-labels.test.ts
@@ -0,0 +1,91 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, test } from "vitest";
+import {
+  isRunId,
+  ledgerPath,
+  newRunId,
+  RUN_ID_ENV,
+  recordResource,
+  testLabels,
+  testResourceName,
+  testRunId,
+} from "../support/docker-test-labels";
+
+const RUN = newRunId(1_700_000_000_000, Buffer.from("0123456789abcdef", "hex"));
+
+describe("run ids", () => {
+  test("a new run id is base-36 time plus 16 hex characters", () => {
+    expect(RUN).toBe(`${(1_700_000_000_000).toString(36)}-0123456789abcdef`);
+    expect(isRunId(RUN)).toBe(true);
+    expect(isRunId(newRunId())).toBe(true);
+  });
+
+  test("rejects malformed ids and the wrong amount of randomness", () => {
+    expect(isRunId("")).toBe(false);
+    expect(isRunId("abc-123")).toBe(false);
+    expect(isRunId(`${RUN} `)).toBe(false);
+    expect(isRunId("aida-test-x")).toBe(false);
+    expect(() => newRunId(Date.now(), Buffer.alloc(4))).toThrow();
+  });
+
+  test("an inherited run id wins and a missing one is created once and stored", () => {
+    const env: Record<string, string | undefined> = { [RUN_ID_ENV]: RUN };
+    expect(testRunId(env)).toBe(RUN);
+
+    const fresh: Record<string, string | undefined> = {};
+    const created = testRunId(fresh);
+    expect(isRunId(created)).toBe(true);
+    expect(fresh[RUN_ID_ENV]).toBe(created);
+    expect(testRunId(fresh)).toBe(created);
+  });
+
+  test("an invalid inherited run id is refused, not replaced", () => {
+    expect(() => testRunId({ [RUN_ID_ENV]: "not-a-run" })).toThrow(/run id/);
+  });
+});
+
+describe("labels and names", () => {
+  test("labels carry the test marker and the run", () => {
+    expect(testLabels(RUN)).toEqual({ "aida.test": "1", "aida.test.run": RUN });
+    expect(() => testLabels("bad")).toThrow();
+  });
+
+  test("names start with aida-test-, carry the run, and differ per call", () => {
+    const name = testResourceName("integration", RUN, Buffer.from("a1b2c3", "hex"));
+    expect(name).toBe(`aida-test-integration-${RUN}-a1b2c3`);
+    expect(testResourceName("e2e", RUN)).not.toBe(testResourceName("e2e", RUN));
+  });
+
+  test("a kind that could escape the prefix scheme is refused", () => {
+    for (const kind of ["", "Integration", "a_b", "-x", "x-", "a/b", "../x"]) {
+      expect(() => testResourceName(kind, RUN)).toThrow();
+    }
+  });
+});
+
+describe("ledger", () => {
+  test("appends one JSON line per resource under the run's file", () => {
+    const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "aida-ledger-test-"));
+    try {
+      recordResource(RUN, { type: "container", name: "aida-test-x", state: "planned" }, tmp);
+      recordResource(
+        RUN,
+        { type: "container", name: "aida-test-x", id: "c1", state: "created" },
+        tmp,
+      );
+      const file = ledgerPath(RUN, tmp);
+      expect(file).toBe(path.join(tmp, "aida-test-runs", `${RUN}.jsonl`));
+      const entries = fs
+        .readFileSync(file, "utf8")
+        .trim()
+        .split("\n")
+        .map((line) => JSON.parse(line));
+      expect(entries.map((entry) => entry.state)).toEqual(["planned", "created"]);
+      expect(entries[1]).toMatchObject({ type: "container", name: "aida-test-x", id: "c1" });
+    } finally {
+      fs.rmSync(tmp, { recursive: true, force: true });
+    }
+  });
+});
diff --git a/tests/unit/docker-test-preflight.test.ts b/tests/unit/docker-test-preflight.test.ts
new file mode 100644
index 0000000..b914c5f
--- /dev/null
+++ b/tests/unit/docker-test-preflight.test.ts
@@ -0,0 +1,245 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, test } from "vitest";
+import { newRunId } from "../support/docker-test-labels";
+import {
+  acquireLock,
+  assertComposeFollowsRuleJ,
+  assertEnoughSpace,
+  assertProjectAbsent,
+  assertSubnetFree,
+  assertTagsFree,
+  type ComposeConfig,
+  cidrOverlaps,
+  type Docker,
+  DockerPreflightError,
+  dockerFreeBytes,
+  hostFreeBytes,
+  lockPath,
+  MIN_FREE_BYTES,
+  parseDfAvailableBytes,
+  tagState,
+} from "../support/docker-test-preflight";
+
+const RUN = newRunId(1_700_000_000_000, Buffer.from("0011223344556677", "hex"));
+const GIB = 1024 ** 3;
+
+function scripted(answers: (args: string[]) => { code: number; stdout?: string; stderr?: string }) {
+  const calls: string[][] = [];
+  const docker: Docker = (args) => {
+    calls.push(args);
+    const answer = answers(args);
+    return { code: answer.code, stdout: answer.stdout ?? "", stderr: answer.stderr ?? "" };
+  };
+  return { docker, calls };
+}
+
+describe("free space", () => {
+  const df =
+    "Filesystem 1024-blocks Used Available Capacity Mounted on\noverlay 41152736 12000000 27000000 31% /\n";
+
+  test("reads the available column of df -Pk in bytes", () => {
+    expect(parseDfAvailableBytes(df)).toBe(27_000_000 * 1024);
+  });
+
+  test("refuses df output it cannot read", () => {
+    expect(() => parseDfAvailableBytes("")).toThrow(DockerPreflightError);
+    expect(() => parseDfAvailableBytes("overlay 1 2 x 3% /")).toThrow(DockerPreflightError);
+  });
+
+  test("20 GiB passes; anything below, or unreadable, stops", () => {
+    expect(() => assertEnoughSpace("host", MIN_FREE_BYTES)).not.toThrow();
+    expect(MIN_FREE_BYTES).toBe(20 * GIB);
+    expect(() => assertEnoughSpace("host", MIN_FREE_BYTES - 1)).toThrow(/below the 20.0 GiB/);
+    expect(() => assertEnoughSpace("host", Number.NaN)).toThrow(DockerPreflightError);
+  });
+
+  test("measures the host with statfs, taking the smallest directory", () => {
+    expect(hostFreeBytes([os.tmpdir(), os.homedir()])).toBeGreaterThan(0);
+  });
+
+  test("measures the Docker VM with a labelled, named, never-pulling one-off container", () => {
+    const { docker, calls } = scripted(() => ({ code: 0, stdout: df }));
+    expect(dockerFreeBytes(docker, RUN)).toBe(27_000_000 * 1024);
+    const args = calls[0];
+    expect(args.slice(0, 4)).toEqual(["run", "--rm", "--pull", "never"]);
+    expect(args).toContain("--network");
+    expect(args[args.indexOf("--name") + 1]).toMatch(
+      new RegExp(`^aida-test-df-${RUN}-[0-9a-f]{6}$`),
+    );
+    expect(args).toContain("aida.test=1");
+    expect(args).toContain(`aida.test.run=${RUN}`);
+  });
+
+  test("a failed probe stops instead of assuming space", () => {
+    const { docker } = scripted(() => ({ code: 125, stderr: "Unable to find image" }));
+    expect(() => dockerFreeBytes(docker, RUN)).toThrow(/nothing is pulled/);
+  });
+});
+
+describe("image tags", () => {
+  test("distinguishes a free tag, a taken tag, and an unknown daemon error", () => {
+    const { docker } = scripted((args) => {
+      const ref = args[args.length - 1];
+      if (ref === "taken:1") return { code: 0, stdout: "sha256:abc" };
+      if (ref === "free:1") return { code: 1, stderr: "Error: No such image: free:1" };
+      return { code: 1, stderr: "Cannot connect to the Docker daemon" };
+    });
+    expect(tagState(docker, "taken:1")).toBe("taken");
+    expect(tagState(docker, "free:1")).toBe("free");
+    expect(() => tagState(docker, "broken:1")).toThrow(/Cannot tell/);
+    expect(() => assertTagsFree(docker, ["free:1", "taken:1"])).toThrow(/taken:1/);
+    expect(() => assertTagsFree(docker, ["free:1"])).not.toThrow();
+  });
+});
+
+describe("compose project", () => {
+  test("passes only when the project has no container, network or volume", () => {
+    expect(() =>
+      assertProjectAbsent(scripted(() => ({ code: 0 })).docker, "aida-test-egress"),
+    ).not.toThrow();
+    const busy = scripted((args) => ({ code: 0, stdout: args[0] === "network" ? "n1\n" : "" }));
+    expect(() => assertProjectAbsent(busy.docker, "aida-test-egress")).toThrow(
+      /already has a network/,
+    );
+    const broken = scripted(() => ({ code: 1, stderr: "daemon down" }));
+    expect(() => assertProjectAbsent(broken.docker, "aida-test-egress")).toThrow(/Cannot list/);
+  });
+});
+
+describe("subnet", () => {
+  test("IPv4 overlap", () => {
+    expect(cidrOverlaps("10.90.0.0/24", "10.90.0.128/25")).toBe(true);
+    expect(cidrOverlaps("10.90.0.0/24", "10.0.0.0/8")).toBe(true);
+    expect(cidrOverlaps("10.90.0.0/24", "10.90.1.0/24")).toBe(false);
+    expect(cidrOverlaps("10.90.0.0/24", "172.17.0.0/16")).toBe(false);
+    expect(cidrOverlaps("10.90.0.0/24", "fd00::/64")).toBe(false);
+  });
+
+  test("stops when an existing network overlaps, naming it", () => {
+    const { docker } = scripted((args) =>
+      args[1] === "ls"
+        ? { code: 0, stdout: "a\nb\n" }
+        : { code: 0, stdout: "bridge|172.17.0.0/16,\nother-project_default|10.90.0.0/16,\n" },
+    );
+    expect(() => assertSubnetFree(docker, "10.90.0.0/24")).toThrow(/other-project_default/);
+  });
+
+  test("passes when nothing overlaps", () => {
+    const { docker } = scripted((args) =>
+      args[1] === "ls"
+        ? { code: 0, stdout: "a\n" }
+        : { code: 0, stdout: "bridge|172.17.0.0/16,\nhost|\n" },
+    );
+    expect(() => assertSubnetFree(docker, "10.90.0.0/24")).not.toThrow();
+  });
+});
+
+describe("lock", () => {
+  test("is exclusive, released only by its own run, and never cleared when stale", () => {
+    const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "aida-lock-test-"));
+    try {
+      const release = acquireLock(RUN, tmp);
+      expect(() => acquireLock(RUN, tmp)).toThrow(/is held/);
+      release();
+      expect(fs.existsSync(lockPath(tmp))).toBe(false);
+
+      const releaseA = acquireLock(RUN, tmp);
+      fs.writeFileSync(lockPath(tmp), JSON.stringify({ runId: "someone-else" }));
+      releaseA();
+      expect(fs.existsSync(lockPath(tmp))).toBe(true);
+    } finally {
+      fs.rmSync(tmp, { recursive: true, force: true });
+    }
+  });
+});
+
+describe("compose rule J check", () => {
+  const labels = { "aida.test": "1", "aida.test.run": RUN };
+  const valid = (): ComposeConfig => ({
+    services: {
+      app: { image: `aida-test-egress-app:${RUN}`, labels, build: { labels } },
+      db: { image: "pgvector/pgvector:pg16", labels, tmpfs: ["/var/lib/postgresql/data"] },
+      smtp: {
+        image: "greenmail/standalone:latest",
+        labels,
+        volumes: [{ type: "bind", source: "/x", target: "/y" }],
+      },
+    },
+    networks: { egress_internal: { labels } },
+    volumes: { uploads_data: { labels } },
+  });
+
+  test("a compliant config returns the built image tags", () => {
+    expect(assertComposeFollowsRuleJ(valid(), "aida-test-egress", RUN)).toEqual([
+      `aida-test-egress-app:${RUN}`,
+    ]);
+  });
+
+  const breakages: [string, (c: ComposeConfig) => void, RegExp][] = [
+    [
+      "service without labels",
+      (c) => {
+        if (c.services) c.services.db.labels = {};
+      },
+      /service db lacks/,
+    ],
+    [
+      "build without labels",
+      (c) => {
+        if (c.services?.app.build) c.services.app.build.labels = undefined;
+      },
+      /build of app/,
+    ],
+    [
+      "built image with a shared tag",
+      (c) => {
+        if (c.services) c.services.app.image = "aida-test-egress-app:latest";
+      },
+      /expected aida-test-egress-app/,
+    ],
+    [
+      "anonymous volume",
+      (c) => {
+        if (c.services) c.services.smtp.volumes = [{ type: "volume", target: "/data" }];
+      },
+      /anonymous volume at \/data/,
+    ],
+    [
+      "Postgres without tmpfs",
+      (c) => {
+        if (c.services) c.services.db.tmpfs = undefined;
+      },
+      /Postgres data/,
+    ],
+    [
+      "network of another run",
+      (c) => {
+        if (c.networks)
+          c.networks.egress_internal.labels = { "aida.test": "1", "aida.test.run": "x" };
+      },
+      /network egress_internal/,
+    ],
+    [
+      "external volume",
+      (c) => {
+        if (c.volumes) c.volumes.uploads_data = { external: true };
+      },
+      /volume uploads_data is external/,
+    ],
+  ];
+  for (const [what, breakIt, message] of breakages) {
+    test(`refuses: ${what}`, () => {
+      const config = valid();
+      breakIt(config);
+      expect(() => assertComposeFollowsRuleJ(config, "aida-test-egress", RUN)).toThrow(message);
+    });
+  }
+
+  test("refuses a project name without the aida-test- prefix", () => {
+    expect(() => assertComposeFollowsRuleJ(valid(), "aida-egress-test", RUN)).toThrow(
+      /lacks aida-test-/,
+    );
+  });
+});
diff --git a/tests/unit/test-docker-cleanup.test.ts b/tests/unit/test-docker-cleanup.test.ts
new file mode 100644
index 0000000..a6eaf82
--- /dev/null
+++ b/tests/unit/test-docker-cleanup.test.ts
@@ -0,0 +1,182 @@
+import { describe, expect, test } from "vitest";
+import {
+  applyCleanup,
+  belongsToRun,
+  type DockerRunner,
+  listOtherRuns,
+  planCleanup,
+} from "../../scripts/test-docker-cleanup";
+import { newRunId } from "../support/docker-test-labels";
+
+const RUN = newRunId(1_700_000_000_000, Buffer.from("00112233445566aa", "hex"));
+const OTHER = newRunId(1_700_000_000_001, Buffer.from("ffeeddccbbaa9988", "hex"));
+
+interface FakeResource {
+  type: "container" | "network" | "volume" | "image";
+  ref: string;
+  name: string;
+  labels: Record<string, string> | null;
+}
+
+/** A tiny in-memory Docker that answers the list, inspect and remove commands the script uses. */
+function fakeDocker(resources: FakeResource[], options: { failRemove?: string[] } = {}) {
+  const calls: string[][] = [];
+  // Deep copy: a test that edits labels must not leak into the next test.
+  const live = resources.map((r) => ({ ...r, labels: r.labels ? { ...r.labels } : null }));
+  const typeOf = (args: string[]): FakeResource["type"] => {
+    if (args[0] === "ps" || args[0] === "rm" || args[0] === "container") return "container";
+    return args[0] as FakeResource["type"];
+  };
+  const runner: DockerRunner = (args) => {
+    calls.push(args);
+    const type = typeOf(args);
+    const verb = args[0] === "ps" ? "ls" : args[0] === "rm" ? "rm" : args[1];
+    if (verb === "ls") {
+      const wanted = args
+        .filter((_, i) => args[i - 1] === "--filter")
+        .map((filter) => filter.replace(/^label=/, "").split("="));
+      return live
+        .filter((r) => r.type === type)
+        .filter((r) => wanted.every(([key, value]) => r.labels?.[key] === value))
+        .map((r) => r.ref)
+        .join("\n");
+    }
+    const ref = args[args.length - 1];
+    const found = live.find((r) => r.type === type && r.ref === ref);
+    if (verb === "inspect") {
+      if (!found) throw new Error(`No such ${type}: ${ref}`);
+      const name = type === "container" ? `/${found.name}` : found.name;
+      return JSON.stringify(
+        type === "image" ? { labels: found.labels } : { name, labels: found.labels },
+      );
+    }
+    if (verb === "rm") {
+      if (options.failRemove?.includes(ref)) throw new Error(`cannot remove ${ref}`);
+      if (!found) throw new Error(`No such ${type}: ${ref}`);
+      live.splice(live.indexOf(found), 1);
+      return "";
+    }
+    throw new Error(`unexpected docker call: ${args.join(" ")}`);
+  };
+  return { runner, calls, live };
+}
+
+const mine = { "aida.test": "1", "aida.test.run": RUN };
+const theirs = { "aida.test": "1", "aida.test.run": OTHER };
+
+const WORLD: FakeResource[] = [
+  { type: "container", ref: "c-mine", name: `aida-test-integration-${RUN}-aaaaaa`, labels: mine },
+  { type: "container", ref: "c-other-run", name: `aida-test-e2e-${OTHER}-bbbbbb`, labels: theirs },
+  // Right labels, wrong name: someone else's container that copied the labels.
+  { type: "container", ref: "c-wrong-name", name: "aida-dev-db", labels: mine },
+  { type: "container", ref: "c-unlabelled", name: "aida-test-loose", labels: null },
+  { type: "network", ref: "n-mine", name: "aida-test-egress_egress_internal", labels: mine },
+  { type: "network", ref: "n-project", name: "mis-demo_default", labels: null },
+  {
+    type: "volume",
+    ref: "aida-test-egress_uploads_data",
+    name: "aida-test-egress_uploads_data",
+    labels: mine,
+  },
+  { type: "volume", ref: "0123abcd", name: "0123abcd", labels: null },
+  { type: "image", ref: `aida-test-egress-app:${RUN}`, name: "", labels: mine },
+  { type: "image", ref: "node:22-alpine", name: "", labels: null },
+  // Labelled for this run but not under the aida-test- repository prefix.
+  { type: "image", ref: `aida:${RUN}`, name: "", labels: mine },
+];
+
+describe("planCleanup", () => {
+  test("selects only resources with the test label, this run, and the aida-test- prefix", () => {
+    const { runner } = fakeDocker(WORLD);
+    const plan = planCleanup(runner, RUN);
+    expect(plan.map((r) => `${r.type}:${r.ref}`)).toEqual([
+      "container:c-mine",
+      "network:n-mine",
+      "volume:aida-test-egress_uploads_data",
+      `image:aida-test-egress-app:${RUN}`,
+    ]);
+  });
+
+  test("a dry run only lists and inspects; it never removes", () => {
+    const { runner, calls } = fakeDocker(WORLD);
+    planCleanup(runner, RUN);
+    expect(calls.some((args) => args.includes("rm"))).toBe(false);
+    expect(calls.some((args) => args.some((a) => a.includes("prune")))).toBe(false);
+  });
+
+  test("an invalid run id is refused before any docker call", () => {
+    const { runner, calls } = fakeDocker(WORLD);
+    expect(() => planCleanup(runner, "aida-test-")).toThrow();
+    expect(calls).toEqual([]);
+  });
+});
+
+describe("applyCleanup", () => {
+  test("removes in order containers, networks, volumes, image tags, and leaves the rest", () => {
+    const { runner, calls, live } = fakeDocker(WORLD);
+    const result = applyCleanup(runner, RUN, planCleanup(runner, RUN));
+    const removals = calls.filter((args) => args[0] === "rm" || args[1] === "rm");
+    expect(removals).toEqual([
+      ["rm", "-f", "c-mine"],
+      ["network", "rm", "n-mine"],
+      ["volume", "rm", "aida-test-egress_uploads_data"],
+      ["image", "rm", `aida-test-egress-app:${RUN}`],
+    ]);
+    expect(result.failed).toEqual([]);
+    expect(live.map((r) => r.ref)).toEqual([
+      "c-other-run",
+      "c-wrong-name",
+      "c-unlabelled",
+      "n-project",
+      "0123abcd",
+      "node:22-alpine",
+      `aida:${RUN}`,
+    ]);
+  });
+
+  test("never removes a container's anonymous volumes and never prunes", () => {
+    const { runner, calls } = fakeDocker(WORLD);
+    applyCleanup(runner, RUN, planCleanup(runner, RUN));
+    expect(calls.some((args) => args[0] === "rm" && args.includes("-v"))).toBe(false);
+    expect(calls.some((args) => args.some((a) => a.includes("prune")))).toBe(false);
+  });
+
+  test("re-checks each resource right before removal and skips one whose labels changed", () => {
+    const { runner, calls, live } = fakeDocker(WORLD);
+    const plan = planCleanup(runner, RUN);
+    const container = live.find((r) => r.ref === "c-mine");
+    if (container) container.labels = theirs;
+    const result = applyCleanup(runner, RUN, plan);
+    expect(result.skipped.map((s) => s.resource.ref)).toEqual(["c-mine"]);
+    expect(calls).not.toContainEqual(["rm", "-f", "c-mine"]);
+  });
+
+  test("a failed removal is reported and the rest still runs", () => {
+    const { runner } = fakeDocker(WORLD, { failRemove: ["n-mine"] });
+    const result = applyCleanup(runner, RUN, planCleanup(runner, RUN));
+    expect(result.failed.map((f) => f.resource.ref)).toEqual(["n-mine"]);
+    expect(result.removed.map((r) => r.ref)).toEqual([
+      "c-mine",
+      "aida-test-egress_uploads_data",
+      `aida-test-egress-app:${RUN}`,
+    ]);
+  });
+});
+
+describe("belongsToRun and listOtherRuns", () => {
+  test("an image is matched on its repository, not its tag", () => {
+    expect(
+      belongsToRun(
+        { type: "image", ref: `x:aida-test-${RUN}`, name: `x:aida-test-${RUN}`, labels: mine },
+        RUN,
+      ),
+    ).toBe(false);
+  });
+
+  test("other runs are listed, never planned", () => {
+    const { runner, calls } = fakeDocker(WORLD);
+    const others = listOtherRuns(runner, RUN);
+    expect(others.map((r) => r.ref)).toEqual(["c-other-run"]);
+    expect(calls.some((args) => args[0] === "rm" || args[1] === "rm")).toBe(false);
+  });
+});
