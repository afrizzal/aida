+ */
+export const FOREIGN_LISTINGS: readonly { name: string; header: RegExp; row: RegExp }[] = [
+  {
+    name: "project-containers",
+    header: /^CONTAINER ID\s+NAMES\s+STATE\s*$/,
+    row: /^[0-9a-f]{12}\s+\S+\s+[a-z]+\s*$/,
+  },
+  {
