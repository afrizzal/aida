# AIDA Caddyfile
# {$DOMAIN:localhost} → reads the DOMAIN env var, falls back to localhost for dev.
# localhost: Caddy issues a certificate via its local CA (see: caddy trust).
# Real domain: Caddy auto-obtains a Let's Encrypt certificate (auto-HTTPS).

{$DOMAIN:localhost} {
  # Body ceiling (D-24): equals PROXY_BODY_LIMIT_BYTES in src/lib/attachments/constants.ts,
  # checked by tests/unit/body-limit-lockstep.test.ts. The route itself refuses bodies above
  # 31 MiB with its own 413, so this sits one MiB higher. The old 12MB value cut legitimate
  # 12 to 30 MB intake submissions. Caddy has no default limit.
  request_body {
    max_size 32MiB
  }
  reverse_proxy app:3000 {
    # The app trusts X-Forwarded-For only because Caddy overwrites it with the TCP peer on
    # every request (D-16); a client-sent value never reaches the app. Do not put another
    # proxy in front of Caddy without reading docs/OPERATIONS.md, "Client IP and reverse proxies".
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}
  }
  encode zstd gzip
}
