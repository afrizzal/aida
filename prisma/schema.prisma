datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

// ---------------------------------------------------------------------------
// Better Auth core tables
// ---------------------------------------------------------------------------

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  // admin plugin fields
  role          String?
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?

  sessions    session[]
  accounts    account[]
  members     member[]
  invitations invitation[]

  assignedTickets  Ticket[]    @relation("TicketAssignee")
  authoredMessages Message[]   @relation("MessageAuthor")
  savedViews       SavedView[]
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // admin plugin field
  impersonatedBy       String?
  // organization plugin field
  activeOrganizationId String?

  @@index([userId])
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Better Auth organization plugin tables
// ---------------------------------------------------------------------------

model organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime
  metadata  String?

  members     member[]
  invitations invitation[]
  settings    Setting[]

  tickets                Ticket[]
  ticketCounter          TicketCounter?
  contacts               Contact[]
  messages               Message[]
  tags                   Tag[]
  slaPolicies            SlaPolicy[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]
  attachments            Attachment[]
  emailIngestFailures    EmailIngestFailure[]
  auditEvents            AuditEvent[]
  kbArticles  KbArticle[]
  kbChunks    KbChunk[]
  insightRuns      InsightRun[]
  ticketEmbeddings TicketEmbedding[]
  csatResponses    CsatResponse[]
  savedViews        SavedView[]
  ticketAuditEvents TicketAuditEvent[]
  ticketRelations   TicketRelation[]
  ticketStates      TicketState[]
  ticketStateConfig TicketStateConfig?
  kbProposals       KbProposal[]
  kbProposalSources KbProposalSource[]
}

model member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

model invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime
  inviterId      String
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           user         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Domain models (Phase 1)
// ---------------------------------------------------------------------------

model Setting {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  value          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Domain models (Phase 2 — core ticketing)
// ---------------------------------------------------------------------------

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageVisibility {
  PUBLIC
  INTERNAL
}

enum MessageDeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum CustomFieldType {
  TEXT
  SELECT
  NUMBER
  CHECKBOX
  DATE
}

// ---------------------------------------------------------------------------
// Domain models (Phase 4 — AI foundation)
// ---------------------------------------------------------------------------

enum TriageCategory {
  BILLING
  TECHNICAL
  ACCOUNT
  FEATURE_REQUEST
  OTHER
}

enum TriageSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum TriageStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AuditActionType {
  TRIAGE
  DRAFT_GENERATED
  DRAFT_APPROVED
  INSIGHT_CLUSTER_LABELS
  INSIGHT_SUMMARY
  KB_PROPOSAL_GENERATED // Phase 12.2 (D-12): one row per KB proposal generation that returned output
}

enum KbEmbeddingStatus {
  PENDING
  COMPLETED
  FAILED
}

model Ticket {
  id                         String         @id @default(cuid())
  organizationId             String
  number                     Int
  statusToken                String         @unique
  subject                    String
  stateId                    String         // Phase 12.1 (D-04): the single source of truth for the state; composite FK to TicketState
  priority                   TicketPriority @default(NORMAL)
  contactId                  String
  assigneeId                 String?
  firstResponseTargetMinutes Int
  resolutionTargetMinutes    Int
  firstResponseDueAt         DateTime
  resolutionDueAt            DateTime
  firstRespondedAt           DateTime?
  resolvedAt                 DateTime?
  isAtRisk                   Boolean        @default(false)
  isBreached                 Boolean        @default(false)
  triageCategory             TriageCategory?
  triageSentiment            TriageSentiment?
  triageLanguage             String?        // ISO 639-1 code, e.g. "en"
  triageStatus               TriageStatus?  // null = never enqueued (AI off); else PENDING/COMPLETED/FAILED
  snoozedUntil               DateTime?      // Phase 12 (D-12): UTC deadline; null = not snoozed
  mergedIntoTicketId         String?        // Phase 12 (D-08): set on a merged source
  mergedAt                   DateTime?      // Phase 12 (D-08): displayed merge date
  mergeMessageSeq            BigInt?        // Phase 12 (D-09 amended): Message.seq marker drawn under the merge row locks
  slaPausedAt                DateTime?      @db.Timestamptz(3) // Phase 12.1 (D-16): start of the open SLA pause; null = not paused
  slaPausedMs                BigInt         @default(0) // Phase 12.1 (D-16): sum of closed pauses in whole milliseconds
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  organization      organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  state             TicketState        @relation(fields: [organizationId, stateId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  contact           Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee          user?              @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages          Message[]
  tags              TicketTag[]
  customFieldValues CustomFieldValue[]
  ticketEmbeddings TicketEmbedding[]
  csatResponse     CsatResponse?
  mergedInto       Ticket?            @relation("TicketMerge", fields: [mergedIntoTicketId], references: [id], onDelete: Restrict)
  mergedFrom       Ticket[]           @relation("TicketMerge")
  relationsFrom    TicketRelation[]   @relation("RelationFrom")
  relationsTo      TicketRelation[]   @relation("RelationTo")
  kbProposalSources KbProposalSource[]

  @@unique([organizationId, number])
  @@unique([organizationId, id]) // Phase 12.2 (D-04): target of KbProposalSource (organizationId, ticketId)
  @@index([organizationId])
  @@index([organizationId, stateId])
  @@index([contactId])
  @@index([snoozedUntil])
  @@index([organizationId, mergedIntoTicketId])
}

model TicketCounter {
  organizationId String       @id
  lastNumber     Int          @default(0)
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  name           String?
  email          String
  phone          String?
  company        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets        Ticket[]
  messages       Message[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Message {
  id              String            @id @default(cuid())
  organizationId  String
  ticketId        String
  direction       MessageDirection
  visibility      MessageVisibility @default(PUBLIC)
  authorUserId    String?
  authorContactId String?
  bodyMarkdown    String
  bodyHtml        String
  triggeredReopen Boolean           @default(false) // true ONLY on a requester follow-up that auto-reopened a RESOLVED/CLOSED ticket (D-04); drives the ThreadSystemEvent "Ticket reopened…" row in the thread (plans 09 agent view + 12 public page)
  emailMessageId  String?
  emailInReplyTo  String?
  emailReferences String[]               @default([])
  deliveryStatus  MessageDeliveryStatus?
  mergedFromTicketId String?             // Phase 12 (D-08): source ticket of a moved message; no relation, provenance survives
  seq             BigInt            @default(autoincrement()) // Phase 12 (D-09 amended): drawn at insert, under the ticket row lock
  createdAt       DateTime          @default(now())
  organization  organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket        Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser    user?        @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorContact Contact?     @relation(fields: [authorContactId], references: [id], onDelete: SetNull)
  attachments   Attachment[]

  @@index([ticketId])
  @@index([organizationId])
  @@index([organizationId, emailMessageId])
  @@index([ticketId, seq])
}

model Tag {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime    @default(now())
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets        TicketTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TicketTag {
  ticketId String
  tagId    String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@index([tagId])
}

model SlaPolicy {
  id                         String         @id @default(cuid())
  organizationId             String
  priority                   TicketPriority
  firstResponseTargetMinutes Int
  resolutionTargetMinutes    Int
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  organization organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, priority])
  @@index([organizationId])
}

model CustomFieldDefinition {
  id             String          @id @default(cuid())
  organizationId String
  label          String
  type           CustomFieldType
  options        Json?
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]

  @@index([organizationId])
}

model CustomFieldValue {
  id                      String    @id @default(cuid())
  organizationId          String
  ticketId                String
  customFieldDefinitionId String
  valueText               String?
  valueNumber             Float?
  valueBoolean            Boolean?
  valueDate               DateTime?
  organization organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  definition   CustomFieldDefinition  @relation(fields: [customFieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([ticketId, customFieldDefinitionId])
  @@index([organizationId])
  @@index([customFieldDefinitionId, valueText])
  @@index([customFieldDefinitionId, valueNumber])
  @@index([customFieldDefinitionId, valueDate])
}

model Attachment {
  id               String   @id @default(cuid())
  organizationId   String
  messageId        String
  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())
  organization organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([organizationId])
}

model EmailIngestFailure {
  id             String   @id @default(cuid())
  organizationId String
  emailMessageId String
  failureCount   Int      @default(1)
  lastError      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, emailMessageId])
  @@index([organizationId])
}

model AuditEvent {
  id             String          @id @default(cuid())
  organizationId String
  actionType     AuditActionType
  ticketId       String?
  messageId      String?
  provider       String          // e.g. "openai"
  model          String          // e.g. "gpt-5.4-mini"
  input          String          // full REDACTED prompt — self-contained copy (D-17)
  output         String          // full model output (JSON string)
  kbProposalId   String?         // Phase 12.2 (D-12): the KB proposal a KB_PROPOSAL_GENERATED row belongs to; composite FK
  createdAt      DateTime        @default(now())
  organization   organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kbProposal     KbProposal?     @relation(fields: [organizationId, kbProposalId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId])
  @@index([organizationId, ticketId])
  @@index([organizationId, kbProposalId])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  scope     String
  ipHash    String
  createdAt DateTime @default(now())

  @@index([scope, ipHash, createdAt])
}

// ---------------------------------------------------------------------------
// Domain models (Phase 5 — RAG knowledge base / drafted replies)
// ---------------------------------------------------------------------------

model KbArticle {
  id               String            @id @default(cuid())
  organizationId   String
  title            String
  slug             String
  bodyMarkdown     String
  bodyHtml         String
  embeddingStatus  KbEmbeddingStatus @default(PENDING)
  embeddingModel   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks           KbChunk[]
  kbProposals      KbProposal[] // Phase 12.2: at most one, enforced by the unique KbProposal.publishedArticleId

  @@unique([organizationId, slug])
  @@unique([organizationId, id]) // Phase 12.2 (D-03): target of KbProposal (organizationId, publishedArticleId)
  @@index([organizationId])
}

model KbChunk {
  id               String       @id @default(cuid())
  organizationId   String
  articleId        String
  position         Int
  headingPath      String?
  content          String
  embeddingModel   String
  createdAt        DateTime     @default(now())
  organization     organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  article          KbArticle    @relation(fields: [articleId], references: [id], onDelete: Cascade)

  embedding Unsupported("vector(768)")

  @@index([organizationId])
  @@index([articleId])
}

// ---------------------------------------------------------------------------
// Domain models (Phase 6 — AIDA Insight)
// ---------------------------------------------------------------------------

enum InsightRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model InsightRun {
  id             String            @id @default(cuid())
  organizationId String
  status         InsightRunStatus  @default(PENDING)
  periodDays     Int
  periodStart    DateTime
  periodEnd      DateTime
  params         Json
  clusters       Json?
  kbGaps         Json?
  volumeDrivers  Json?
  slaCsat        Json?
  narrative      Json?
  ticketCount    Int?
  embeddingModel String?
  provider       String?
  model          String?
  error          String?
  createdAt      DateTime          @default(now())
  completedAt    DateTime?
  organization   organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, periodDays, status])
  @@index([organizationId])
}

model TicketEmbedding {
  id             String       @id @default(cuid())
  organizationId String
  ticketId       String
  embeddingModel String
  createdAt      DateTime     @default(now())
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  embedding Unsupported("vector(768)")

  @@unique([ticketId, embeddingModel])
  @@index([organizationId])
}

model CsatResponse {
  id             String       @id @default(cuid())
  organizationId String
  ticketId       String       @unique
  score          Int
  comment        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Domain models (Phase 11 — Inbox: saved views and ticket audit)
// ---------------------------------------------------------------------------

enum SavedViewVisibility {
  PRIVATE
  SHARED
}

enum TicketAuditActorType {
  USER
  SYSTEM
}

enum TicketAuditAction {
  ASSIGNEE_CHANGED
  STATUS_CHANGED
  PRIORITY_CHANGED
  TAG_ADDED
  TAG_REMOVED
  AUTO_CLOSED
  RELATION_ADDED
  RELATION_REMOVED
  MERGED_INTO
  MERGED_FROM
  SNOOZED
  WOKEN
}

// The two partial unique name indexes (SavedView_private_name_key per owner among PRIVATE
// views, SavedView_shared_name_key per organization among SHARED views, both on lower(name))
// and the CHECK constraint SavedView_name_length_check (1 to 80 characters) live ONLY in
// migration 20261108140000_inbox, because Prisma cannot express them. Any migration Prisma
// generates after that one must keep them (delete any DROP statement for them by hand).
model SavedView {
  id             String              @id @default(cuid())
  organizationId String
  ownerUserId    String
  name           String
  visibility     SavedViewVisibility
  /// Stored inbox filters: { version: 2, view, stateIds, tagId?, cf?, q?, snoozed? } (src/lib/tickets/list-filters.ts).
  /// Version 1 views ({ version: 1, statuses }) were converted by migration 20261110100000_ticket_states (Phase 12.1, D-09).
  filters        Json
  position       Int
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          user                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, visibility, position])
  @@index([organizationId, ownerUserId])
}

// Append-only at the database level: trigger aida_ticket_audit_event_no_update_delete
// (function aida_ticket_audit_event_immutable) rejects UPDATE and DELETE. The CHECK constraint
// TicketAuditEvent_actor_check (SYSTEM with null actorUserId, USER with a non-null one) lives
// only in migration 20261108140000_inbox; later Prisma-generated migrations must keep it.
// ticketId and actorUserId carry no relation on purpose: history survives ticket and user
// removal. before/after hold ids, enum values and booleans only, never ticket text.
model TicketAuditEvent {
  id             String               @id @default(cuid())
  organizationId String
  ticketId       String
  actorType      TicketAuditActorType
  actorUserId    String?
  action         TicketAuditAction
  before         Json
  after          Json
  batchId        String?
  createdAt      DateTime             @default(now())
  organization   organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, ticketId])
  @@index([organizationId, batchId])
}

// ---------------------------------------------------------------------------
// Domain models (Phase 12 — Ticket lifecycle: relations, merge, snooze)
// ---------------------------------------------------------------------------

enum TicketRelationType {
  DUPLICATE_OF
  RELATED_TO
  CHILD_OF
}

// Hand-written objects that live ONLY in migration 20261109100000_ticket_lifecycle, because
// Prisma cannot express them: the unique expression index TicketRelation_pair_key (one relation
// per unordered pair: organizationId, LEAST and GREATEST of the two ticket ids), the CHECK
// TicketRelation_no_self_check (no self-link) and the partial unique index
// TicketRelation_one_parent_key (one CHILD_OF parent per child). The same migration also adds the
// CHECK Ticket_merge_fields_check on Ticket. Any migration Prisma generates after that one must
// keep them (delete any DROP statement for them by hand).
// CHILD_OF: from is the child, to is the parent. createdById carries no relation on purpose:
// history survives user removal.
model TicketRelation {
  id             String             @id @default(cuid())
  organizationId String
  type           TicketRelationType
  fromTicketId   String
  toTicketId     String
  createdById    String
  createdAt      DateTime           @default(now())
  organization   organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromTicket     Ticket             @relation("RelationFrom", fields: [fromTicketId], references: [id], onDelete: Cascade)
  toTicket       Ticket             @relation("RelationTo", fields: [toTicketId], references: [id], onDelete: Cascade)

  @@index([organizationId, fromTicketId])
  @@index([organizationId, toTicketId])
}

// ---------------------------------------------------------------------------
// Domain models (Phase 12.1 — Ticket lifecycle: custom states and SLA pause)
// ---------------------------------------------------------------------------

// Declaration order matters: PostgreSQL sorts enum values by it (OPEN, PENDING, RESOLVED, CLOSED).
enum TicketStateGroup {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

// Hand-written objects that live ONLY in migration 20261110100000_ticket_states, because Prisma
// cannot express them: the CHECKs TicketState_name_check (trimmed, 1 to 40 characters),
// TicketState_color_token_check (UI-SPEC palette keys) and TicketState_legacy_status_check; the
// partial unique index TicketState_active_name_key (organizationId, lower(name)) WHERE
// "deletedAt" IS NULL; the partial unique index TicketState_legacy_status_key (organizationId,
// legacyStatus) WHERE "legacyStatus" IS NOT NULL; the function aida_seed_ticket_states and the
// trigger aida_organization_ticket_states (AFTER INSERT ON "organization", function
// aida_organization_seed_ticket_states) that give every organization its five default states and
// its TicketStateConfig row; the trigger aida_ticket_state_group_fixed (function
// aida_ticket_state_group_immutable) that refuses a change of "group"; and the CHECK
// Ticket_sla_paused_ms_check on Ticket. Any migration Prisma generates after that one must keep
// them (delete any DROP statement for them by hand).
// States are soft-deleted (deletedAt, K42) and never hard-deleted while referenced.
// legacyStatus is the old TicketStatus key of the five migrated or default states, used only to
// map old URLs (D-09); it never decides behaviour.
model TicketState {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  colorToken     String
  group          TicketStateGroup
  sortOrder      Int
  legacyStatus   String?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets        Ticket[]
  configNew        TicketStateConfig[] @relation("TicketStateConfigNew")
  configReopen     TicketStateConfig[] @relation("TicketStateConfigReopen")
  configResolve    TicketStateConfig[] @relation("TicketStateConfigResolve")
  configAutoClose  TicketStateConfig[] @relation("TicketStateConfigAutoClose")
  configMergeClose TicketStateConfig[] @relation("TicketStateConfigMergeClose")

  @@unique([organizationId, id])
  @@index([organizationId, group, sortOrder])
}

// One row per organization (D-05): the five role states, each a composite FK to
// TicketState (organizationId, id). Created by aida_seed_ticket_states (see TicketState).
model TicketStateConfig {
  organizationId    String       @id
  newStateId        String
  reopenStateId     String
  resolveStateId    String
  autoCloseStateId  String
  mergeCloseStateId String
  updatedAt         DateTime     @updatedAt
  organization      organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  newState          TicketState  @relation("TicketStateConfigNew", fields: [organizationId, newStateId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reopenState       TicketState  @relation("TicketStateConfigReopen", fields: [organizationId, reopenStateId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  resolveState      TicketState  @relation("TicketStateConfigResolve", fields: [organizationId, resolveStateId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  autoCloseState    TicketState  @relation("TicketStateConfigAutoClose", fields: [organizationId, autoCloseStateId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  mergeCloseState   TicketState  @relation("TicketStateConfigMergeClose", fields: [organizationId, mergeCloseStateId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
}

// ---------------------------------------------------------------------------
// Domain models (Phase 12.2 — Ticket lifecycle: knowledge from resolved work, KB proposals)
// ---------------------------------------------------------------------------

enum KbProposalStatus {
  GENERATING
  DRAFT
  REJECTED
  PUBLISHED
  FAILED
}

// REQUESTER_NOT_ALLOWED: the requester lost the owner or admin role before generation (D-01).
enum KbProposalFailureCode {
  AI_OFF
  SOURCE_CHANGED
  PROVIDER
  INVALID_OUTPUT
  CONFIGURATION
  REQUESTER_NOT_ALLOWED
  UNKNOWN
}

// Hand-written objects that live ONLY in migration 20261111100000_kb_proposals, because Prisma
// cannot express them: the CHECKs KbProposal_version_check (version >= 0),
// KbProposal_generation_epoch_check ("generationEpoch" >= 1), KbProposal_title_length_check (null
// or 3 to 120 code points), KbProposal_status_fields_check (the columns each status requires) and
// KbProposalSource_position_check (1 to 5); the function aida_kb_proposal_status_immutable and the
// trigger aida_kb_proposal_status_fence (BEFORE UPDATE ON "KbProposal") that refuse every status
// change except GENERATING to DRAFT or FAILED and DRAFT to PUBLISHED or REJECTED, and any change of
// title, bodyMarkdown or publishedArticleId on a REJECTED, PUBLISHED or FAILED row (D-16). Any
// migration Prisma generates after that one must keep them (delete any DROP statement for them by
// hand).
// A proposal never gets KbChunk rows, an embedding or a KbArticle row before the explicit publish
// action (D-05, D-06). Review actions live on these columns, never in AuditEvent (D-02, D-12).
// Actor columns carry no relation on purpose (the TicketAuditEvent.actorUserId shape).
model KbProposal {
  id                 String                 @id @default(cuid())
  organizationId     String
  status             KbProposalStatus       @default(GENERATING)
  version            Int                    @default(0) // D-16: incremented by every write; conditional updates match it
  // Review R2-3: identifies the current generation. The request leaves it at 1, every restart
  // increments it in its conditional update; the job payload carries it and every claim, release,
  // storing and failing update of the job requires it.
  generationEpoch    Int                    @default(1)
  title              String?
  bodyMarkdown       String?
  inputTruncated     Boolean                @default(false) // D-10: part of a thread was dropped from the input
  failureCode        KbProposalFailureCode?
  requestedByUserId  String
  // Review C5: the request and every restart set it; isStuck counts from it while
  // generationClaimedAt is null.
  generationQueuedAt DateTime               @default(now())
  generationClaimedAt DateTime?
  generatedAt        DateTime?
  lastEditedByUserId String?
  lastEditedAt       DateTime?
  rejectedByUserId   String?
  rejectedAt         DateTime?
  publishedByUserId  String?
  publishedAt        DateTime?
  failedAt           DateTime?
  publishedArticleId String?                @unique
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  organization       organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publishedArticle   KbArticle?             @relation(fields: [organizationId, publishedArticleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  sources            KbProposalSource[]
  auditEvents        AuditEvent[]

  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
}

model KbProposalSource {
  organizationId String
  proposalId     String
  ticketId       String
  position       Int // 1 to 5 (KbProposalSource_position_check)
  snapshotSeq    BigInt? // D-08: the ticket's largest PUBLIC message seq at read time (plan 12.2-04), set when the result is stored
  citedSections  String[] // D-11: the section labels the model cited this source for, shown only to the reviewer
  createdAt      DateTime     @default(now())
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal       KbProposal   @relation(fields: [organizationId, proposalId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  ticket         Ticket       @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([proposalId, ticketId])
  @@unique([proposalId, position])
  @@index([organizationId, ticketId])
}
