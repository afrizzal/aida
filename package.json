    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "prisma": "7.10.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "rehype-parse": "9.0.1",
